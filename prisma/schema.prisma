
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  tasks        Task[]
  categories   Category[]
  goals        Goal[]
  habits       Habit[]
  habitEntries HabitEntry[]
  myDayEntries MyDayEntry[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#64748b")
  isDefault Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  userId      String
  categoryId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subtasks     Subtask[]
  goals        TaskGoal[]
  myDayEntries MyDayEntry[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([dueDate])
  @@index([categoryId])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Goal {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("ACTIVE")
  manualProgress Int      @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskGoal[]

  @@index([userId])
  @@index([userId, status])
}

model TaskGoal {
  taskId String
  goalId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([taskId, goalId])
  @@index([goalId])
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  description String?
  isActive    Boolean  @default(true)
  recurrence  Json
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId])
  @@index([userId, isActive])
}

model HabitEntry {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  date        DateTime @db.Date
  isCompleted Boolean  @default(true)
  createdAt   DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model MyDayEntry {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, date])
  @@index([userId, date])
}
